@model LogeoV2.ViewModels.LoginVM
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es" class="h-100" data-tema="claro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Sistema de Reclamos</title>
    <script>
            document.documentElement.setAttribute('data-tema', localStorage.getItem('tema') || 'claro');
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            .auth-wrapper {
                min-height: 100vh;
                background-color: var(--color-fondo);
                background-image: radial-gradient(ellipse at top, var(--color-acento-suave), transparent 60%);
            }

            .auth-card {
                max-width: 420px;
                background-color: var(--color-tarjeta);
                border: 1px solid var(--color-borde);
                border-top: 3px solid var(--color-acento);
                border-radius: var(--radio-md);
                box-shadow: var(--sombra-panel-hover);
                color: var(--color-texto);
            }

            .auth-header {
                background: transparent;
                border: none;
                text-align: center;
                padding: 2rem 1rem 1rem;
            }

                .auth-header img {
                    width: 80px;
                    height: auto;
                    margin-bottom: 1rem;
                }

                .auth-header h4 {
                    font-weight: 600;
                }

                .auth-header p {
                    color: var(--color-texto-suave);
                    margin-bottom: 0;
                }

            .auth-card .form-control {
                padding: 0.75rem 1rem;
            }

            .form-floating > label {
                padding: 0.75rem 1rem;
                color: var(--color-texto-suave);
            }

            [data-tema="oscuro"] .form-floating > .form-control:focus ~ label,
            [data-tema="oscuro"] .form-floating > .form-control:not(:placeholder-shown) ~ label {
                color: var(--color-texto-suave) !important;
            }

                [data-tema="oscuro"] .form-floating > .form-control:focus ~ label::after,
                [data-tema="oscuro"] .form-floating > .form-control:not(:placeholder-shown) ~ label::after {
                    background-color: transparent !important;
                }

            .btn-login {
                padding: 0.75rem 1rem;
                font-weight: 500;
            }

            .divider {
                display: flex;
                align-items: center;
                text-align: center;
                margin: 1rem 0;
            }

                .divider::before,
                .divider::after {
                    content: '';
                    flex: 1;
                    border-bottom: 1px solid var(--color-borde);
                }

                .divider span {
                    padding: 0 1rem;
                    color: var(--color-texto-suave);
                    font-size: 0.875rem;
                }

            .toggle-password {
                width: 38px;
                height: 38px;
                display: flex;
                align-items: center;
                justify-content: center;
                right: 8px !important;
            }

                .toggle-password i {
                    font-size: 1.1rem;
                }
    </style>
</head>
<body class="h-100">
    <div class="auth-wrapper d-flex align-items-center py-5">
        <div class="container">
            <div class="card auth-card mx-auto">
                <div class="auth-header">
                    <img src="~/img/logo-navbar.png" alt="Municipalidad de Unquillo" class="mb-2" />
                    <h4 class="mb-1">Iniciar Sesión</h4>
                    <p>Ingresá tus credenciales</p>
                </div>
                <div class="card-body p-4">
                    @if (TempData["RegistroExitoso"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            @TempData["RegistroExitoso"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-controller="Acceso" asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-floating mb-3">
                            <input type="email" class="form-control" id="correo" placeholder="nombre@ejemplo.com" required asp-for="Correo">
                            <label for="correo"><i class="bi bi-envelope me-2"></i>Correo electrónico</label>
                            <span asp-validation-for="Correo" class="text-danger"></span>
                        </div>
                        <div class="form-floating mb-3 position-relative">
                            <input type="password" class="form-control pe-5" id="clave" placeholder="Contraseña" asp-for="Clave">
                            <label for="clave"><i class="bi bi-lock me-2"></i>Contraseña</label>
                            <span asp-validation-for="Clave" class="text-danger"></span>
                            <button type="button" class="btn btn-link position-absolute top-50 end-0 translate-middle-y toggle-password"
                                    data-target="clave">
                                <i class="bi bi-eye-slash text-secondary"></i>
                            </button>
                        </div>

                        @if (ViewData["Error"] != null)
                        {
                            <div class="alert alert-danger d-flex align-items-center" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <div>@ViewData["Error"]</div>
                            </div>
                        }

                        <button class="btn btn-primary w-100 btn-login mb-4" type="submit">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión
                        </button>

                        <div class="divider">
                            <span>¿No tenés una cuenta?</span>
                        </div>

                        <a asp-controller="Acceso" asp-action="Registrarse" class="btn btn-outline-secondary w-100 btn-login">
                            <i class="bi bi-person-plus me-2"></i>Crear cuenta
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
            document.addEventListener('DOMContentLoaded', function() {
                const toggleButtons = document.querySelectorAll('.toggle-password');

                toggleButtons.forEach(button => {
                    button.addEventListener('click', function() {
                        const targetId = this.getAttribute('data-target');
                        const passwordInput = document.getElementById(targetId);
                        const icon = this.querySelector('i');

                        if (passwordInput.type === 'password') {
                            passwordInput.type = 'text';
                            icon.classList.remove('bi-eye-slash');
                            icon.classList.add('bi-eye');
                        } else {
                            passwordInput.type = 'password';
                            icon.classList.remove('bi-eye');
                            icon.classList.add('bi-eye-slash');
                        }
                    });
                });
            });
    </script>
</body>
</html>