@model LogeoV2.ViewModels.PaginacionParams

@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Paginación" class="mt-3">
        <ul class="pagination">
            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link" href="@Model.ConstruirUrl(Model.PaginaActual - 1)">Anterior</a>
            </li>

            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                    <a class="page-link" href="@Model.ConstruirUrl(i)">@i</a>
                </li>
            }

            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" href="@Model.ConstruirUrl(Model.PaginaActual + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}