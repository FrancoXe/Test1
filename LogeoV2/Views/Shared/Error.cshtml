@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="panel error-pagina-sistema mx-auto text-center py-5">
    <img src="~/img/logo-navbar.png" alt="Municipalidad de Unquillo" style="height: 72px;" class="mb-4" />

    <i class="bi bi-exclamation-triangle error-icono-sistema"></i>
    <h1 class="h2 fw-bold mb-2" style="color: var(--color-acento);">Ocurrió un error</h1>
    <p class="mb-4" style="color: var(--color-texto-suave);">
        No pudimos procesar tu solicitud. Intentá nuevamente en unos minutos.
    </p>

    @if (Model.ShowRequestId)
    {
        <div class="request-id mb-4">
            <span class="small" style="color: var(--color-texto-suave);">Código de seguimiento</span>
            <div class="d-flex justify-content-center align-items-center gap-2 mt-1">
                <code id="requestIdTexto">@Model.RequestId</code>
                <button type="button" class="btn btn-sm btn-outline-secondary" title="Copiar código"
                        onclick="navigator.clipboard.writeText(document.getElementById('requestIdTexto').textContent)">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
        </div>
    }

    <div class="d-flex justify-content-center gap-2 flex-wrap">
        <button type="button" class="btn btn-outline-secondary" onclick="history.back()">
            <i class="bi bi-arrow-left me-1"></i> Volver atrás
        </button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house-door me-1"></i> Volver al inicio
        </a>
    </div>
</div>

<style>
    .error-pagina-sistema {
        max-width: 560px;
        margin-top: 2rem;
    }

    .error-icono-sistema {
        display: block;
        font-size: 2.5rem;
        color: var(--color-texto-suave);
        margin-bottom: 0.5rem;
    }

    .request-id code {
        color: var(--color-texto);
        background-color: var(--color-tarjeta-header);
        border: 1px solid var(--color-borde);
        border-radius: var(--radio-sm);
        padding: 0.25rem 0.6rem;
    }
</style>