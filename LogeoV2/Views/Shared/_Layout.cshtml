@{
    var controlador = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLowerInvariant();
    var accion = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLowerInvariant();
    bool Es(string c, string a) => controlador == c.ToLowerInvariant() && accion == a.ToLowerInvariant();
    var esAdmin = User.IsInRole("Administrador");
}
<!DOCTYPE html>
<html lang="es" data-tema="claro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LogeoV2</title>
    <script>
            // Se aplica antes de pintar para evitar parpadeos (tema y estado de la barra lateral)
            document.documentElement.setAttribute('data-tema', localStorage.getItem('tema') || 'claro');
            if (localStorage.getItem('sidebarExpandida') === '1') {
                document.documentElement.classList.add('sb-expandida');
            }
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
            :root {
                --ancho-sb-contraida: 64px;
                --ancho-sb-expandida: 250px;
                --ancho-sidebar: var(--ancho-sb-contraida);
                --alto-topbar: 60px;
            }

            html.sb-expandida {
                --ancho-sidebar: var(--ancho-sb-expandida);
            }

            body {
                margin-bottom: 0;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            /* ===== BARRA SUPERIOR: ancho completo, dos zonas (menú + logo | buscador centrado) ===== */
            .app-topbar {
                position: sticky;
                top: 0;
                z-index: 1020;
                flex: 0 0 auto;
                display: grid;
                grid-template-columns: 1fr minmax(0, 640px) 1fr;
                align-items: center;
                column-gap: 1rem;
                height: var(--alto-topbar);
                padding: 0 1.5rem 0 11px;
                background-color: var(--color-navbar);
                border-bottom: 1px solid var(--color-borde);
                transition: background-color 0.2s ease, border-color 0.2s ease;
            }

                .app-topbar .tb-izq {
                    grid-column: 1;
                    grid-row: 1;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                    justify-self: start;
                }

                .app-topbar .tb-centro {
                    grid-column: 2;
                    grid-row: 1;
                    min-width: 0;
                }

                .app-topbar .marca img {
                    height: 36px;
                    width: auto;
                    display: block;
                }

                .app-topbar .busqueda-global .form-control,
                .app-topbar .busqueda-global .btn {
                    height: 40px;
                }

                .app-topbar .busqueda-global .btn {
                    padding: 0 0.9rem;
                }

                .app-topbar .ico-btn {
                    position: relative;
                    width: 42px;
                    height: 42px;
                    padding: 0;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    flex-shrink: 0;
                    border: none;
                    border-radius: var(--radio-sm);
                    background: transparent;
                    color: var(--color-texto-suave);
                    font-size: 1.25rem;
                    text-decoration: none;
                    cursor: pointer;
                    transition: background-color 0.15s ease, color 0.15s ease;
                }

                    .app-topbar .ico-btn:hover {
                        background-color: var(--color-acento-suave);
                        color: var(--color-acento);
                    }

                    .app-topbar .ico-btn:focus-visible {
                        outline: 2px solid var(--color-acento);
                        outline-offset: 1px;
                    }

            /* ===== CUERPO: barra lateral + contenido ===== */
            .app-cuerpo {
                flex: 1 1 auto;
                display: flex;
                min-width: 0;
            }

            .app-sidebar {
                position: sticky;
                top: var(--alto-topbar);
                align-self: flex-start;
                flex: 0 0 auto;
                width: var(--ancho-sidebar);
                height: calc(100vh - var(--alto-topbar));
                z-index: 1030;
                display: flex;
                flex-direction: column;
                background-color: var(--color-navbar);
                border-right: 1px solid var(--color-borde);
                transition: width 0.25s ease, background-color 0.2s ease, border-color 0.2s ease;
            }

            .sb-cabecera-movil {
                display: none;
            }

            .sb-lista,
            .sb-pie {
                display: flex;
                flex-direction: column;
                gap: 0.25rem;
                padding: 0.5rem 10px 0.5rem 11px;
            }

            .sb-lista {
                padding-top: 0.75rem;
            }

            /* Campanita y engranaje: abajo de todo */
            .sb-pie {
                margin-top: auto;
                border-top: 1px solid var(--color-borde);
            }

            .app-sidebar .sb-item {
                position: relative;
                display: flex;
                align-items: center;
                width: 100%;
                height: 42px;
                padding: 0;
                border: none;
                border-radius: var(--radio-sm);
                background: transparent;
                color: var(--color-texto-suave);
                font-size: 0.9rem;
                font-weight: 500;
                text-align: left;
                text-decoration: none;
                white-space: nowrap;
                cursor: pointer;
                transition: background-color 0.15s ease, color 0.15s ease;
            }

                .app-sidebar .sb-item:hover,
                .app-sidebar .sb-item.show {
                    background-color: var(--color-acento-suave);
                    color: var(--color-acento);
                }

                .app-sidebar .sb-item:focus-visible {
                    outline: 2px solid var(--color-acento);
                    outline-offset: 1px;
                }

            /* Los íconos ocupan siempre la misma columna de 42px: no se mueven al expandir */
            .app-sidebar .sb-icono {
                position: relative;
                width: 42px;
                height: 42px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.25rem;
            }

            .app-sidebar .sb-badge {
                position: absolute;
                top: 3px;
                right: 1px;
                font-size: 0.6rem;
            }

            .app-sidebar .sb-etiqueta {
                flex: 1;
                min-width: 0;
                overflow: hidden;
                text-overflow: ellipsis;
                opacity: 0;
                transition: opacity 0.15s ease;
            }

            html.sb-expandida .app-sidebar .sb-etiqueta {
                opacity: 1;
                transition-delay: 0.1s;
            }

            /* Sección activa: marca naranja pegada al borde */
            .app-sidebar .sb-item.activo {
                color: var(--color-acento);
                background-color: var(--color-acento-suave);
            }

                .app-sidebar .sb-item.activo::before {
                    content: '';
                    position: absolute;
                    left: -11px;
                    top: 50%;
                    transform: translateY(-50%);
                    width: 3px;
                    height: 22px;
                    border-radius: 0 3px 3px 0;
                    background-color: var(--color-acento);
                }

            .app-sidebar .sb-sep {
                width: 24px;
                height: 1px;
                margin: 0.5rem auto;
                background-color: var(--color-borde);
                transition: width 0.25s ease;
            }

            html.sb-expandida .app-sidebar .sb-sep {
                width: 100%;
            }

            /* Tooltip: solo con la barra contraída (y no mientras hay un menú abierto) */
            html:not(.sb-expandida) .app-sidebar .sb-item[data-etiqueta]:hover::after,
            html:not(.sb-expandida) .app-sidebar .sb-item[data-etiqueta]:focus-visible::after {
                content: attr(data-etiqueta);
                position: absolute;
                left: calc(100% + 14px);
                top: 50%;
                transform: translateY(-50%);
                padding: 0.3rem 0.65rem;
                font-size: 0.8rem;
                font-weight: 500;
                white-space: nowrap;
                color: var(--color-texto);
                background-color: var(--color-tarjeta);
                border: 1px solid var(--color-borde);
                border-radius: var(--radio-sm);
                box-shadow: var(--sombra-panel-hover);
                pointer-events: none;
                z-index: 1040;
            }

            .app-sidebar .sb-item.show::after {
                display: none !important;
            }

            /* ===== MENÚS DE LA BARRA LATERAL (notificaciones y ajustes) ===== */
            /* Se abren hacia la derecha, alineados con la parte de abajo del botón.
                       Con data-bs-display="static" Bootstrap no los posiciona: lo hace este CSS. */
            .app-sidebar .dropdown {
                position: relative;
            }

                .app-sidebar .dropdown .sb-menu {
                    top: auto;
                    bottom: 0;
                    left: calc(100% + 14px);
                    right: auto;
                    margin: 0;
                    min-width: 15rem;
                    padding: 0.4rem;
                }

                .app-sidebar .dropdown .sb-menu-notif {
                    width: 320px;
                    max-height: 400px;
                    overflow-y: auto;
                    padding: 0.5rem;
                }

            .sb-menu .dropdown-item {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 0.5rem 0.65rem;
                border-radius: var(--radio-sm);
                font-size: 0.9rem;
                font-weight: 500;
            }

                .sb-menu .dropdown-item i {
                    width: 1.25rem;
                    text-align: center;
                    font-size: 1.1rem;
                    color: var(--color-texto-suave);
                }

                .sb-menu .dropdown-item:hover i {
                    color: var(--color-acento);
                }

            .sb-fondo {
                display: none;
            }

            /* ===== CONTENIDO ===== */
            .app-main {
                flex: 1 1 auto;
                min-width: 0;
                display: flex;
                flex-direction: column;
            }

            .app-contenido {
                flex: 1;
                width: 100%;
                max-width: 1400px;
                margin: 0 auto;
                padding: 1.5rem;
            }

            /* Pie de página: al final de la ventana si hay poco contenido y después del contenido
                       si hay mucho (sin position: fixed) */
            .app-footer {
                margin-top: auto;
                padding: 1rem 1.5rem;
                font-size: 0.875rem;
                color: var(--color-texto-suave);
                border-top: 1px solid var(--color-borde);
            }

                .app-footer .app-footer-link {
                    color: var(--color-texto-suave);
                }

                    .app-footer .app-footer-link:hover {
                        color: var(--color-acento);
                    }

            /* ===== TABLET ===== */
            @@media (max-width: 991.98px) {
                .app-topbar {
                    grid-template-columns: auto minmax(0, 1fr) auto;
                    padding-right: 1rem;
                }
            }

            /* ===== CELULAR: la barra lateral pasa a panel deslizable ===== */
            @@media (max-width: 767.98px) {
                .app-sidebar {
                    position: fixed;
                    top: 0;
                    bottom: 0;
                    left: 0;
                    height: auto;
                    width: var(--ancho-sb-expandida);
                    max-width: 85vw;
                    transform: translateX(-100%);
                    visibility: hidden;
                    transition: transform 0.25s ease, visibility 0s linear 0.25s;
                }

                html.sb-movil-abierta .app-sidebar {
                    transform: none;
                    visibility: visible;
                    transition: transform 0.25s ease, visibility 0s;
                    box-shadow: var(--sombra-panel-hover);
                }

                .sb-cabecera-movil {
                    height: var(--alto-topbar);
                    flex-shrink: 0;
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    padding: 0 10px 0 1rem;
                    border-bottom: 1px solid var(--color-borde);
                    font-weight: 600;
                }

                    .sb-cabecera-movil .sb-item {
                        width: 42px;
                    }

                .app-sidebar .sb-etiqueta {
                    opacity: 1;
                }

                .app-sidebar .sb-sep {
                    width: 100%;
                }
                /* Los menús se abren hacia arriba, dentro de la pantalla */
                .app-sidebar .dropdown .sb-menu {
                    left: 0;
                    bottom: calc(100% + 6px);
                    width: min(300px, calc(100vw - 1.5rem));
                    min-width: 0;
                }

                html:not(.sb-expandida) .app-sidebar .sb-item[data-etiqueta]:hover::after,
                html:not(.sb-expandida) .app-sidebar .sb-item[data-etiqueta]:focus-visible::after {
                    display: none;
                }

                .sb-fondo {
                    display: block;
                    position: fixed;
                    inset: 0;
                    z-index: 1025;
                    background-color: rgba(0, 0, 0, 0.45);
                    opacity: 0;
                    visibility: hidden;
                    transition: opacity 0.25s ease, visibility 0s linear 0.25s;
                }

                html.sb-movil-abierta .sb-fondo {
                    opacity: 1;
                    visibility: visible;
                    transition: opacity 0.25s ease, visibility 0s;
                }

                .app-contenido {
                    padding: 1rem;
                }

                #btnVolverArriba {
                    bottom: 16px !important;
                }
            }

            /* ===== PANTALLAS MUY ANGOSTAS: el buscador pasa a una segunda fila ===== */
            @@media (max-width: 575.98px) {
                .app-topbar {
                    height: auto;
                    min-height: var(--alto-topbar);
                    grid-template-columns: 1fr;
                    row-gap: 0.5rem;
                    padding: 0.5rem 1rem 0.5rem 0.5rem;
                }

                    .app-topbar .tb-centro {
                        grid-column: 1;
                        grid-row: 2;
                    }
            }

            @@media (max-height: 520px) {
                .sb-lista {
                    flex: 1 1 auto;
                    min-height: 0;
                    overflow-y: auto;
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                .app-sidebar,
                .app-sidebar .sb-etiqueta,
                .app-sidebar .sb-sep,
                .sb-fondo {
                    transition: none !important;
                }
            }
    </style>
</head>
<body>
    <header class="app-topbar">
        <div class="tb-izq">
            <button type="button" class="ico-btn" id="btnSidebar" aria-controls="appSidebar"
                    aria-expanded="false" aria-label="Expandir menú" title="Menú">
                <i class="bi bi-list"></i>
            </button>
            <a class="marca" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/img/logo-navbar.png" alt="Municipalidad de Unquillo — Inicio" />
            </a>
        </div>

        @if (esAdmin)
        {
            <div class="tb-centro">
                <div class="busqueda-global">
                    <div class="input-group">
                        <input type="text" id="inputBusquedaGlobal" class="form-control" placeholder="Buscar por ID o DNI" aria-label="Buscar por ID o DNI" />
                        <button type="button" id="btnBusquedaGlobal" class="btn btn-outline-secondary" title="Buscar" aria-label="Buscar">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </header>

    <div class="app-cuerpo">
        <nav class="app-sidebar" id="appSidebar" aria-label="Navegación principal">
            <div class="sb-cabecera-movil">
                <span>Menú</span>
                <button type="button" class="sb-item" id="btnCerrarSidebar" aria-label="Cerrar menú">
                    <span class="sb-icono"><i class="bi bi-x-lg"></i></span>
                </button>
            </div>

            <div class="sb-lista">
                <button type="button" class="sb-item" id="btnNuevoReclamo" data-etiqueta="Nuevo reclamo"
                        data-bs-toggle="modal" data-bs-target="#modalReclamo">
                    <span class="sb-icono"><i class="bi bi-plus-circle"></i></span>
                    <span class="sb-etiqueta">Nuevo reclamo</span>
                </button>

                <a class="sb-item @(Es("Reclamos", "MisReclamos") ? "activo" : "")" data-etiqueta="Mis reclamos"
                   aria-current="@(Es("Reclamos", "MisReclamos") ? "page" : null)"
                   asp-controller="Reclamos" asp-action="MisReclamos">
                    <span class="sb-icono"><i class="bi bi-list-check"></i></span>
                    <span class="sb-etiqueta">Mis reclamos</span>
                </a>

                @if (User.IsInRole("Departamento"))
                {
                    <a class="sb-item @(Es("Reclamos", "MisReclamosDepartamento") ? "activo" : "")" data-etiqueta="Mis reclamos (Depto.)"
                       aria-current="@(Es("Reclamos", "MisReclamosDepartamento") ? "page" : null)"
                       asp-controller="Reclamos" asp-action="MisReclamosDepartamento">
                        <span class="sb-icono"><i class="bi bi-building"></i></span>
                        <span class="sb-etiqueta">Mis reclamos (Depto.)</span>
                    </a>
                }

                @if (esAdmin)
                {
                    <span class="sb-sep" role="separator"></span>

                    <a class="sb-item @(Es("Reclamos", "Gestionar") ? "activo" : "")" data-etiqueta="Gestionar reclamos"
                       aria-current="@(Es("Reclamos", "Gestionar") ? "page" : null)"
                       asp-controller="Reclamos" asp-action="Gestionar">
                        <span class="sb-icono"><i class="bi bi-inbox"></i></span>
                        <span class="sb-etiqueta">Gestionar reclamos</span>
                    </a>
                    <a class="sb-item @(Es("Reclamos", "Historial") ? "activo" : "")" data-etiqueta="Historial"
                       aria-current="@(Es("Reclamos", "Historial") ? "page" : null)"
                       asp-controller="Reclamos" asp-action="Historial">
                        <span class="sb-icono"><i class="bi bi-clock-history"></i></span>
                        <span class="sb-etiqueta">Historial</span>
                    </a>
                    <a class="sb-item @(Es("Reclamos", "Metricas") ? "activo" : "")" data-etiqueta="Reportes"
                       aria-current="@(Es("Reclamos", "Metricas") ? "page" : null)"
                       asp-controller="Reclamos" asp-action="Metricas">
                        <span class="sb-icono"><i class="bi bi-bar-chart-line"></i></span>
                        <span class="sb-etiqueta">Reportes</span>
                    </a>
                    <a class="sb-item @(Es("Administracion", "Usuarios") ? "activo" : "")" data-etiqueta="Usuarios"
                       aria-current="@(Es("Administracion", "Usuarios") ? "page" : null)"
                       asp-area="" asp-controller="Administracion" asp-action="Usuarios">
                        <span class="sb-icono"><i class="bi bi-people"></i></span>
                        <span class="sb-etiqueta">Usuarios</span>
                    </a>
                }
            </div>

            <div class="sb-pie">
                <div class="dropdown">
                    <button type="button" class="sb-item" id="dropdownNotificaciones" data-etiqueta="Notificaciones"
                            data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" aria-label="Notificaciones">
                        <span class="sb-icono">
                            <i class="bi bi-bell"></i>
                            <span id="badgeNotificaciones" class="badge rounded-pill bg-danger sb-badge d-none">0</span>
                        </span>
                        <span class="sb-etiqueta">Notificaciones</span>
                    </button>
                    <div class="dropdown-menu sb-menu sb-menu-notif shadow" id="listaNotificaciones" aria-labelledby="dropdownNotificaciones">
                        <div class="text-center text-muted py-3">Cargando...</div>
                    </div>
                </div>

                <div class="dropdown">
                    <button type="button" class="sb-item" id="dropdownAjustes" data-etiqueta="Ajustes"
                            data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" aria-label="Ajustes">
                        <span class="sb-icono"><i class="bi bi-gear"></i></span>
                        <span class="sb-etiqueta">Ajustes</span>
                    </button>
                    <ul class="dropdown-menu sb-menu shadow" aria-labelledby="dropdownAjustes">
                        <li>
                            <button type="button" class="dropdown-item" id="btnModoOscuro">
                                <i class="bi bi-moon-stars" id="iconoModoOscuro"></i>
                                <span id="textoModoOscuro">Interfaz oscura</span>
                            </button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#modalAyuda">
                                <i class="bi bi-question-circle"></i>
                                <span>Ayuda</span>
                            </button>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <a class="dropdown-item" asp-controller="Acceso" asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Cerrar sesión</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="app-main">
            <div class="app-contenido">
                @if (ViewData["Breadcrumb"] != null)
                {
                    var items = ((List<(string Texto, string? Url)>)ViewData["Breadcrumb"]!);
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-3" id="breadcrumbList">
                            <li class="breadcrumb-item">
                                <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                                    <i class="bi bi-house-door"></i>
                                </a>
                            </li>
                            @for (int i = 0; i < items.Count; i++)
                            {
                                if (i == items.Count - 1)
                                {
                                    <li class="breadcrumb-item active" aria-current="page">@items[i].Texto</li>
                                }
                                else
                                {
                                    <li class="breadcrumb-item">
                                        <a href="@items[i].Url" class="text-decoration-none">@items[i].Texto</a>
                                    </li>
                                }
                            }
                        </ol>
                    </nav>
                }

                <main role="main">
                    @RenderBody()
                </main>
            </div>

            <footer class="app-footer">
                &copy; @DateTime.Now.Year - LogeoV2 -
                <a class="app-footer-link" asp-area="" asp-controller="Home" asp-action="Privacy">Política de privacidad</a>
            </footer>
        </div>
    </div>

    <div class="sb-fondo" id="sbFondo"></div>

    <div class="modal fade" id="modalReclamo" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="contenidoModalReclamo">
                <div class="modal-body text-center py-5">
                    <div class="spinner-border" role="status"></div>
                </div>
            </div>
        </div>
    </div>

    <partial name="_ModalAyuda" />

    <button id="btnVolverArriba" class="btn btn-primary rounded-circle shadow d-none"
            style="position: fixed; bottom: 24px; right: 24px; width: 48px; height: 48px; z-index: 1000;"
            title="Volver arriba">
        <i class="bi bi-arrow-up"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            const btnVolverArriba = document.getElementById('btnVolverArriba');

            window.addEventListener('scroll', function () {
                if (window.scrollY > 300) {
                    btnVolverArriba.classList.remove('d-none');
                } else {
                    btnVolverArriba.classList.add('d-none');
                }
            });

            btnVolverArriba.addEventListener('click', function () {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
    </script>

    <script>
            // ===== BARRA LATERAL: expandir / contraer (escritorio) y abrir / cerrar (celular) =====
            const raizSidebar = document.documentElement;
            const btnSidebar = document.getElementById('btnSidebar');
            const btnCerrarSidebar = document.getElementById('btnCerrarSidebar');
            const fondoSidebar = document.getElementById('sbFondo');
            const mqMovil = window.matchMedia('(max-width: 767.98px)');

            function sidebarAbierta() {
                return mqMovil.matches
                    ? raizSidebar.classList.contains('sb-movil-abierta')
                    : raizSidebar.classList.contains('sb-expandida');
            }

            function actualizarAriaSidebar() {
                const abierta = sidebarAbierta();
                const texto = mqMovil.matches
                    ? (abierta ? 'Cerrar menú' : 'Abrir menú')
                    : (abierta ? 'Contraer menú' : 'Expandir menú');
                btnSidebar.setAttribute('aria-expanded', abierta);
                btnSidebar.setAttribute('aria-label', texto);
            }

            function alternarSidebar() {
                if (mqMovil.matches) {
                    raizSidebar.classList.toggle('sb-movil-abierta');
                } else {
                    const expandida = raizSidebar.classList.toggle('sb-expandida');
                    localStorage.setItem('sidebarExpandida', expandida ? '1' : '0');
                }
                actualizarAriaSidebar();
            }

            function cerrarSidebarMovil() {
                raizSidebar.classList.remove('sb-movil-abierta');
                actualizarAriaSidebar();
            }

            btnSidebar.addEventListener('click', alternarSidebar);
            btnCerrarSidebar.addEventListener('click', cerrarSidebarMovil);
            fondoSidebar.addEventListener('click', cerrarSidebarMovil);

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') cerrarSidebarMovil();
            });

            // En celular, al elegir una opción el panel se cierra (salvo los botones que abren un menú y el cambio de tema)
            document.querySelectorAll('#appSidebar .sb-item:not([data-bs-toggle="dropdown"]):not(#btnCerrarSidebar)').forEach(function (item) {
                item.addEventListener('click', cerrarSidebarMovil);
            });

            document.querySelectorAll('#appSidebar .sb-menu .dropdown-item:not(#btnModoOscuro)').forEach(function (item) {
                item.addEventListener('click', cerrarSidebarMovil);
            });

            mqMovil.addEventListener('change', cerrarSidebarMovil);

            actualizarAriaSidebar();
    </script>

    <script>
            const inputBusquedaGlobal = document.getElementById('inputBusquedaGlobal');
            const btnBusquedaGlobal = document.getElementById('btnBusquedaGlobal');

            async function ejecutarBusquedaGlobal() {
                const termino = inputBusquedaGlobal.value.trim();
                if (!termino) return;

                const res = await fetch(`/Reclamos/BuscarGlobal?termino=${encodeURIComponent(termino)}`);
                const data = await res.json();

                if (data.tipo === 'detalle') {
                    window.open(data.url, '_blank');
                } else {
                    window.location.href = data.url;
                }
            }

            if (btnBusquedaGlobal) {
                btnBusquedaGlobal.addEventListener('click', ejecutarBusquedaGlobal);

                inputBusquedaGlobal.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        ejecutarBusquedaGlobal();
                    }
                });
            }
    </script>

    <script>
            const html = document.documentElement;
            const iconoModo = document.getElementById('iconoModoOscuro');
            const textoModo = document.getElementById('textoModoOscuro');

            function aplicarTema(tema) {
                html.setAttribute('data-tema', tema);
                if (iconoModo) {
                    iconoModo.classList.toggle('bi-moon-stars', tema === 'claro');
                    iconoModo.classList.toggle('bi-sun', tema === 'oscuro');
                }
                if (textoModo) {
                    textoModo.textContent = tema === 'claro' ? 'Interfaz oscura' : 'Interfaz clara';
                }
            }

            const temaGuardado = localStorage.getItem('tema') || 'claro';
            aplicarTema(temaGuardado);

            document.getElementById('btnModoOscuro')?.addEventListener('click', function () {
                const temaActual = html.getAttribute('data-tema');
                const nuevoTema = temaActual === 'claro' ? 'oscuro' : 'claro';
                aplicarTema(nuevoTema);
                localStorage.setItem('tema', nuevoTema);
            });
    </script>

    <script>
            const modalReclamo = document.getElementById('modalReclamo');

            modalReclamo.addEventListener('show.bs.modal', function () {
                fetch('/Reclamos/NuevoModal')
                    .then(res => res.text())
                    .then(html => {
                        document.getElementById('contenidoModalReclamo').innerHTML = html;
                        inicializarFormReclamo();
                    });
            });

            function inicializarFormReclamo() {
                const selectCategoria = document.getElementById('selectCategoria');
                const selectSubcategoria = document.getElementById('selectSubcategoria');
                const form = document.getElementById('formNuevoReclamo');
                const inputArchivo = document.getElementById('archivoAdjunto');
                const avisoArchivo = document.getElementById('avisoArchivo');

                selectCategoria.addEventListener('change', function () {
                    const idCategoria = this.value;
                    selectSubcategoria.innerHTML = '<option value="">Cargando...</option>';

                    if (!idCategoria) {
                        selectSubcategoria.innerHTML = '<option value="">Seleccioná primero una categoría</option>';
                        return;
                    }

                    fetch(`/Reclamos/GetSubcategorias?idCategoria=${idCategoria}`)
                        .then(res => res.json())
                        .then(data => {
                            selectSubcategoria.innerHTML = '<option value="">Seleccioná una subcategoría</option>';
                            data.forEach(s => {
                                const option = document.createElement('option');
                                option.value = s.id;
                                option.textContent = s.nombre;
                                selectSubcategoria.appendChild(option);
                            });
                        });
                });

                if (inputArchivo) {
                    inputArchivo.addEventListener('change', function () {
                        avisoArchivo.classList.add('d-none');
                        avisoArchivo.textContent = '';

                        const archivo = this.files[0];
                        if (!archivo) return;

                        const tiposValidos = ['image/jpeg', 'image/png', 'image/jpg', 'image/webp'];
                        const tamanioMaximo = 5 * 1024 * 1024;

                        if (!tiposValidos.includes(archivo.type)) {
                            avisoArchivo.textContent = 'Solo se permiten imágenes (JPG, PNG o WEBP).';
                            avisoArchivo.classList.remove('d-none');
                            this.value = '';
                            return;
                        }

                        if (archivo.size > tamanioMaximo) {
                            const tamanioMB = (archivo.size / (1024 * 1024)).toFixed(1);
                            avisoArchivo.textContent = `El archivo pesa ${tamanioMB}MB. El máximo permitido es 5MB.`;
                            avisoArchivo.classList.remove('d-none');
                            this.value = '';
                            return;
                        }
                    });
                }

                form.addEventListener('submit', function (e) {
                    e.preventDefault();

                    if (avisoArchivo && !avisoArchivo.classList.contains('d-none')) {
                        return;
                    }

                    const formData = new FormData(form);

                    fetch('/Reclamos/Crear', { method: 'POST', body: formData })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                bootstrap.Modal.getInstance(modalReclamo).hide();
                                alert(data.mensaje);
                            } else {
                                document.getElementById('contenidoModalReclamo').innerHTML = data;
                                inicializarFormReclamo();
                            }
                        });
                });
            }

            async function cargarNotificaciones() {
                const res = await fetch('/Notificaciones/Obtener');
                if (!res.ok) return;
                const data = await res.json();

                const badge = document.getElementById('badgeNotificaciones');
                if (data.noLeidas > 0) {
                    badge.textContent = data.noLeidas;
                    badge.classList.remove('d-none');
                } else {
                    badge.classList.add('d-none');
                }

                const lista = document.getElementById('listaNotificaciones');
                if (data.notificaciones.length === 0) {
                    lista.innerHTML = '<div class="text-center text-muted py-3">Sin notificaciones</div>';
                    return;
                }

                lista.innerHTML = data.notificaciones.map(n => `
                    <div class="dropdown-item-text border-bottom py-2 ${n.leida ? '' : 'bg-light'}" style="white-space: normal;">
                        <strong>${n.titulo}</strong>
                        <div class="small">${n.mensaje}</div>
                        <div class="text-muted small">${n.fecha}</div>
                    </div>
                `).join('');
            }

            document.getElementById('dropdownNotificaciones').addEventListener('click', async function () {
                await fetch('/Notificaciones/MarcarTodasLeidas', { method: 'POST' });
                setTimeout(cargarNotificaciones, 500);
            });

            cargarNotificaciones();
            setInterval(cargarNotificaciones, 30000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>