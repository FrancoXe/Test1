<!DOCTYPE html>
<html lang="en" data-tema="claro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LogeoV2</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LogeoV2.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/img/logo-navbar.png" alt="Municipalidad de Unquillo" style="height: 40px;" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark fs-5" href="#" id="btnNuevoReclamo" data-bs-toggle="modal" data-bs-target="#modalReclamo" title="Nuevo Reclamo">
                                <i class="bi bi-plus-circle"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Reclamos" asp-action="MisReclamos">Mis Reclamos</a>
                        </li>
                        @if (User.IsInRole("Departamento"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Reclamos" asp-action="MisReclamosDepartamento">Mis Reclamos (Depto.)</a>
                            </li>
                        }
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Administracion" asp-action="Usuarios">Usuarios</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Reclamos" asp-action="Historial">Historial</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Reclamos" asp-action="Gestionar">Gestionar Reclamos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Reclamos" asp-action="Metricas">Reportes</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark position-relative d-inline-flex" href="#" id="dropdownNotificaciones"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notificaciones">
                                <i class="bi bi-bell fs-5"></i>
                                <span id="badgeNotificaciones" class="badge rounded-pill bg-danger position-absolute d-none"
                                      style="top: -2px; right: -6px; font-size: 0.6rem;">
                                    0
                                </span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end p-2 shadow" style="width: 320px; max-height: 400px; overflow-y: auto;"
                                 aria-labelledby="dropdownNotificaciones" id="listaNotificaciones">
                                <div class="text-center text-muted py-3">Cargando...</div>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="#" data-bs-toggle="modal" data-bs-target="#modalAyuda" title="Ayuda">
                                <i class="bi bi-question-circle fs-5"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="#" id="btnModoOscuro" title="Cambiar tema">
                                <i class="bi bi-moon-stars fs-5" id="iconoModoOscuro"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Acceso" asp-action="Logout" title="Cerrar sesión">
                                <i class="bi bi-box-arrow-right fs-5"></i>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @if (ViewData["Breadcrumb"] != null)
    {
        var items = ((List<(string Texto, string? Url)>)ViewData["Breadcrumb"]!);
        <nav aria-label="breadcrumb" class="container mt-2">
            <ol class="breadcrumb mb-2" id="breadcrumbList">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                        <i class="bi bi-house-door"></i>
                    </a>
                </li>
                @for (int i = 0; i < items.Count; i++)
                {
                    if (i == items.Count - 1)
                    {
                        <li class="breadcrumb-item active" aria-current="page">@items[i].Texto</li>
                    }
                    else
                    {
                        <li class="breadcrumb-item">
                            <a href="@items[i].Url" class="text-decoration-none">@items[i].Texto</a>
                        </li>
                    }
                }
            </ol>
        </nav>
    }

    <button id="btnVolverArriba" class="btn btn-primary rounded-circle shadow d-none"
            style="position: fixed; bottom: 24px; right: 24px; width: 48px; height: 48px; z-index: 1000;"
            title="Volver arriba">
        <i class="bi bi-arrow-up"></i>
    </button>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - LogeoV2 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <div class="modal fade" id="modalReclamo" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="contenidoModalReclamo">
                <div class="modal-body text-center py-5">
                    <div class="spinner-border" role="status"></div>
                </div>
            </div>
        </div>
    </div>

    <partial name="_ModalAyuda" />


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>


    <script>
        const html = document.documentElement;
        const iconoModo = document.getElementById('iconoModoOscuro');

        function aplicarTema(tema) {
            html.setAttribute('data-tema', tema);
            if (iconoModo) {
                iconoModo.classList.toggle('bi-moon-stars', tema === 'claro');
                iconoModo.classList.toggle('bi-sun', tema === 'oscuro');
            }
        }

        const temaGuardado = localStorage.getItem('tema') || 'claro';
        aplicarTema(temaGuardado);

        document.getElementById('btnModoOscuro')?.addEventListener('click', function () {
            const temaActual = html.getAttribute('data-tema');
            const nuevoTema = temaActual === 'claro' ? 'oscuro' : 'claro';
            aplicarTema(nuevoTema);
            localStorage.setItem('tema', nuevoTema);
        });
    </script>

    <script>
        const modalReclamo = document.getElementById('modalReclamo');

        modalReclamo.addEventListener('show.bs.modal', function () {
            fetch('/Reclamos/NuevoModal')
                .then(res => res.text())
                .then(html => {
                    document.getElementById('contenidoModalReclamo').innerHTML = html;
                    inicializarFormReclamo();
                });
        });

        function inicializarFormReclamo() {
            const selectCategoria = document.getElementById('selectCategoria');
            const selectSubcategoria = document.getElementById('selectSubcategoria');
            const form = document.getElementById('formNuevoReclamo');
            const inputArchivo = document.getElementById('archivoAdjunto');
            const avisoArchivo = document.getElementById('avisoArchivo');

            selectCategoria.addEventListener('change', function () {
                const idCategoria = this.value;
                selectSubcategoria.innerHTML = '<option value="">Cargando...</option>';

                if (!idCategoria) {
                    selectSubcategoria.innerHTML = '<option value="">Seleccioná primero una categoría</option>';
                    return;
                }

                fetch(`/Reclamos/GetSubcategorias?idCategoria=${idCategoria}`)
                    .then(res => res.json())
                    .then(data => {
                        selectSubcategoria.innerHTML = '<option value="">Seleccioná una subcategoría</option>';
                        data.forEach(s => {
                            const option = document.createElement('option');
                            option.value = s.id;
                            option.textContent = s.nombre;
                            selectSubcategoria.appendChild(option);
                        });
                    });
            });

            if (inputArchivo) {
                inputArchivo.addEventListener('change', function () {
                    avisoArchivo.classList.add('d-none');
                    avisoArchivo.textContent = '';

                    const archivo = this.files[0];
                    if (!archivo) return;

                    const tiposValidos = ['image/jpeg', 'image/png', 'image/jpg', 'image/webp'];
                    const tamanioMaximo = 5 * 1024 * 1024;

                    if (!tiposValidos.includes(archivo.type)) {
                        avisoArchivo.textContent = 'Solo se permiten imágenes (JPG, PNG o WEBP).';
                        avisoArchivo.classList.remove('d-none');
                        this.value = '';
                        return;
                    }

                    if (archivo.size > tamanioMaximo) {
                        const tamanioMB = (archivo.size / (1024 * 1024)).toFixed(1);
                        avisoArchivo.textContent = `El archivo pesa ${tamanioMB}MB. El máximo permitido es 5MB.`;
                        avisoArchivo.classList.remove('d-none');
                        this.value = '';
                        return;
                    }
                });
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();

                if (avisoArchivo && !avisoArchivo.classList.contains('d-none')) {
                    return;
                }

                const formData = new FormData(form);

                fetch('/Reclamos/Crear', { method: 'POST', body: formData })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            bootstrap.Modal.getInstance(modalReclamo).hide();
                            alert(data.mensaje);
                        } else {
                            document.getElementById('contenidoModalReclamo').innerHTML = data;
                            inicializarFormReclamo();
                        }
                    });
            });
        }

        async function cargarNotificaciones() {
            const res = await fetch('/Notificaciones/Obtener');
            if (!res.ok) return;
            const data = await res.json();

            const badge = document.getElementById('badgeNotificaciones');
            if (data.noLeidas > 0) {
                badge.textContent = data.noLeidas;
                badge.classList.remove('d-none');
            } else {
                badge.classList.add('d-none');
            }

            const lista = document.getElementById('listaNotificaciones');
            if (data.notificaciones.length === 0) {
                lista.innerHTML = '<div class="text-center text-muted py-3">Sin notificaciones</div>';
                return;
            }

            lista.innerHTML = data.notificaciones.map(n => `
                <div class="dropdown-item-text border-bottom py-2 ${n.leida ? '' : 'bg-light'}" style="white-space: normal;">
                    <strong>${n.titulo}</strong>
                    <div class="small">${n.mensaje}</div>
                    <div class="text-muted small">${n.fecha}</div>
                </div>
            `).join('');
        }

        document.getElementById('dropdownNotificaciones').addEventListener('click', async function () {
            await fetch('/Notificaciones/MarcarTodasLeidas', { method: 'POST' });
            setTimeout(cargarNotificaciones, 500);
        });

        cargarNotificaciones();
        setInterval(cargarNotificaciones, 30000);
    </script>

    <script>
        const btnVolverArriba = document.getElementById('btnVolverArriba');

        window.addEventListener('scroll', function () {
            if (window.scrollY > 300) {
                btnVolverArriba.classList.remove('d-none');
            } else {
                btnVolverArriba.classList.add('d-none');
            }
        });

        btnVolverArriba.addEventListener('click', function () {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>