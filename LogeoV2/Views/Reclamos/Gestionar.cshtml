@model LogeoV2.ViewModels.GestionReclamosVM
@{
    ViewData["Title"] = "Gestionar Reclamos";
    ViewData["Breadcrumb"] = new List<(string, string?)> { ("Gestionar Reclamos", null) };
}

<h1>Gestionar Reclamos</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-info">@TempData["Mensaje"]</div>
}

<form method="get" asp-action="Gestionar" class="mb-4">
    <div class="d-flex align-items-center gap-2">
        <div class="input-group rounded-pill overflow-hidden flex-grow-1" style="max-width: 600px;">
            <input type="text" name="busqueda" value="@Model.Busqueda"
                   class="form-control border-0 ps-4" placeholder="Buscar por vecino"
                   style="box-shadow: none;" />
            <button type="submit" class="btn btn-light border-0 px-3">
                <i class="bi bi-search"></i>
            </button>
        </div>

        <div class="dropdown ms-auto">
            <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-1"
                    type="button" id="dropdownFiltrosGestionar" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-sliders"></i> Filtros
            </button>
            <div class="dropdown-menu dropdown-menu-end p-3 shadow" style="width: 260px;" aria-labelledby="dropdownFiltrosGestionar">
                <div class="mb-3">
                    <label class="form-label mb-1">Estado</label>
                    <select name="estado" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var e in Model.EstadosDisponibles)
                        {
                            <option value="@e" selected="@(Model.Estado == e)">@e</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary btn-sm w-100">Aplicar filtros</button>
            </div>
        </div>
    </div>
</form>

<ul class="nav nav-tabs mb-3" id="tabsGestion" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabActivos" type="button">Activos</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabVencidos" type="button">
            Vencidos
            @if (Model.ReclamosVencidos.Any())
            {
                <span class="badge bg-danger ms-1">@Model.ReclamosVencidos.Count</span>
            }
        </button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tabActivos">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Vecino</th>
                    <th>Categoría</th>
                    <th>Subcategoría</th>
                    <th>Barrio</th>
                    <th>Dirección</th>
                    <th>Descripción</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Departamento Asignado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Reclamos)
                {
                    <tr data-id-reclamo="@r.IdReclamo" data-estado-original="@r.Estado">
                        <td>@r.IdReclamo</td>
                        <td>@r.Usuario?.Nombre @r.Usuario?.Apellido</td>
                        <td>@r.Categoria?.Nombre</td>
                        <td>@r.Subcategoria?.Nombre</td>
                        <td>@r.Barrio?.Nombre</td>
                        <td>@r.Direccion</td>
                        <td>@r.Descripcion</td>
                        <td>@r.FechaCreacion.ToString("g")</td>
                        <td>
                            <select class="form-select form-select-sm select-estado">
                                @foreach (var e in Model.EstadosDisponibles)
                                {
                                    <option value="@e" selected="@(e == r.Estado)">@e</option>
                                }
                            </select>
                        </td>
                        <td>@(r.DepartamentoAsignado?.Nombre ?? "—")</td>
                        <td class="d-flex">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle"
                                    style="width: 32px; height: 32px; padding: 0;"
                                    title="Ver más"
                                    onclick="window.open('@Url.Action("VerDetallePdf", new { id = r.IdReclamo })', '_blank')">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle ms-1"
                                    style="width: 32px; height: 32px; padding: 0;"
                                    title="Historial de cambios"
                                    data-bs-toggle="modal" data-bs-target="#modalHistorialEstados"
                                    onclick="cargarHistorialEstados(@r.IdReclamo)">
                                <i class="bi bi-clock-history"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <partial name="_Paginacion" model="@(new LogeoV2.ViewModels.PaginacionParams {
            PaginaActual = Model.PaginaActual,
            TotalPaginas = Model.TotalPaginas,
            AccionUrl = Url.Action("Gestionar", "Reclamos") ?? "",
            ParametrosExtra = new Dictionary<string, string?> { { "estado", Model.Estado }, { "busqueda", Model.Busqueda } }
        })" />

        <button type="button" id="btnGuardarCambios" class="btn btn-primary">Guardar cambios</button>
    </div>

    <div class="tab-pane fade" id="tabVencidos">
        @if (!Model.ReclamosVencidos.Any())
        {
            <p class="text-muted">No hay reclamos vencidos (pendientes hace más de 7 días).</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Vecino</th>
                        <th>Categoría</th>
                        <th>Barrio</th>
                        <th>Descripción</th>
                        <th>Días pendiente</th>
                        <th>Cambiar Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.ReclamosVencidos)
                    {
                        var dias = (DateTime.UtcNow - r.FechaCreacion).Days;
                        <tr class="table-warning" data-id-reclamo="@r.IdReclamo" data-estado-original="@r.Estado">
                            <td>@r.IdReclamo</td>
                            <td>@r.Usuario?.Nombre @r.Usuario?.Apellido</td>
                            <td>@r.Categoria?.Nombre</td>
                            <td>@r.Barrio?.Nombre</td>
                            <td>@r.Descripcion</td>
                            <td><span class="badge bg-danger">@dias días</span></td>
                            <td>
                                <select class="form-select form-select-sm select-estado">
                                    @foreach (var e in Model.EstadosDisponibles)
                                    {
                                        <option value="@e" selected="@(e == r.Estado)">@e</option>
                                    }
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <button type="button" id="btnGuardarCambiosVencidos" class="btn btn-primary">Guardar cambios</button>
        }
    </div>
</div>

<div class="modal fade" id="modalHistorialEstados" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="contenidoHistorialEstados">
            <div class="modal-body text-center py-5">
                <div class="spinner-border" role="status"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalConfirmarRechazo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Confirmar rechazo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="mensajeConfirmarRechazo">Estás por rechazar 1 reclamo. Esta acción notificará al vecino. ¿Confirmás?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="btnConfirmarRechazo">Sí, rechazar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function cargarHistorialEstados(idReclamo) {
            fetch(`/Reclamos/HistorialEstadosReclamo?id=${idReclamo}`)
                .then(res => res.text())
                .then(html => {
                    document.getElementById('contenidoHistorialEstados').innerHTML = html;
                });
        }

                function recolectarCambios(selectorFilas) {
            const filas = document.querySelectorAll(selectorFilas);
            const cambios = [];

            filas.forEach(fila => {
                const idReclamo = fila.getAttribute('data-id-reclamo');
                const estadoOriginal = fila.getAttribute('data-estado-original');
                const nuevoEstado = fila.querySelector('.select-estado').value;

                if (nuevoEstado !== estadoOriginal) {
                    cambios.push({ idReclamo, nuevoEstado });
                }
            });

            return cambios;
        }

        async function ejecutarGuardado(cambios, boton) {
            boton.disabled = true;
            boton.textContent = 'Guardando...';

            for (const cambio of cambios) {
                const formData = new URLSearchParams();
                formData.append('idReclamo', cambio.idReclamo);
                formData.append('nuevoEstado', cambio.nuevoEstado);
                formData.append('notificar', 'true');

                await fetch('@Url.Action("CambiarEstadoAjax", "Reclamos")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData
                });
            }

            location.reload();
        }

        function guardarCambios(cambios, boton) {
            if (cambios.length === 0) {
                alert('No hay cambios para guardar.');
                return;
            }

            const cantidadRechazos = cambios.filter(c => c.nuevoEstado === 'Rechazado').length;

            if (cantidadRechazos > 0) {
                const mensaje = cantidadRechazos === 1
                    ? 'Estás por rechazar 1 reclamo. Esta acción notificará al vecino. ¿Confirmás?'
                    : `Estás por rechazar ${cantidadRechazos} reclamos. Esta acción notificará a los vecinos. ¿Confirmás?`;

                document.getElementById('mensajeConfirmarRechazo').textContent = mensaje;

                const modal = new bootstrap.Modal(document.getElementById('modalConfirmarRechazo'));
                modal.show();

                const btnConfirmar = document.getElementById('btnConfirmarRechazo');
                const nuevoBtn = btnConfirmar.cloneNode(true);
                btnConfirmar.parentNode.replaceChild(nuevoBtn, btnConfirmar);

                nuevoBtn.addEventListener('click', function () {
                    modal.hide();
                    ejecutarGuardado(cambios, boton);
                });
            } else {
                ejecutarGuardado(cambios, boton);
            }
        }

        const btnActivos = document.getElementById('btnGuardarCambios');
        if (btnActivos) {
            btnActivos.addEventListener('click', function () {
                guardarCambios(recolectarCambios('#tabActivos tr[data-id-reclamo]'), btnActivos);
            });
        }

        const btnVencidos = document.getElementById('btnGuardarCambiosVencidos');
        if (btnVencidos) {
            btnVencidos.addEventListener('click', function () {
                guardarCambios(recolectarCambios('#tabVencidos tr[data-id-reclamo]'), btnVencidos);
            });
        }
    </script>
}