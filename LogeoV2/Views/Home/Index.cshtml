@using System.Security.Claims
@{
    ViewData["Title"] = "Página Principal";
}

@if (User.Identity!.IsAuthenticated)
{
    var nombreCompleto = $"{User.FindFirst(ClaimTypes.Name)?.Value} {User.FindFirst(ClaimTypes.Surname)?.Value}";

    <div class="panel text-center py-5">
        <h1 class="display-5 fw-semibold mb-2">Bienvenido, @nombreCompleto</h1>
        <p class="fs-5 mb-0" style="color: var(--color-texto-suave);">
            Sistema de Gestión de Reclamos — Municipalidad de Unquillo
        </p>
    </div>
}