@using System.Security.Claims
@{
    ViewData["Title"] = "Página Principal";
}

@if (User.Identity!.IsAuthenticated)
{
    var nombreCompleto = $"{User.FindFirst(ClaimTypes.Name)?.Value} {User.FindFirst(ClaimTypes.Surname)?.Value}";
    <div class="text-center py-5">
        <h1 class="display-4">Bienvenido, @nombreCompleto</h1>
        <p class="text-muted fs-5">Sistema de Gestión de Reclamos — Municipalidad de Unquillo</p>
    </div>
}