@{
    var codigo = ViewData["Codigo"]?.ToString() ?? "Error";
    var titulo = codigo switch
    {
        "404" => "Página no encontrada",
        "403" => "Acceso denegado",
        "500" => "Error interno del servidor",
        _ => "Ocurrió un error"
    };
    var mensaje = codigo switch
    {
        "404" => "La página que buscás no existe o fue movida.",
        "403" => "No tenés permisos para acceder a esta sección.",
        "500" => "Algo salió mal de nuestro lado. Ya estamos trabajando en solucionarlo.",
        _ => "Ocurrió un problema inesperado."
    };
    var icono = codigo switch
    {
        "404" => "bi-search",
        "403" => "bi-shield-lock",
        "500" => "bi-exclamation-octagon",
        _ => "bi-exclamation-triangle"
    };
    ViewData["Title"] = titulo;
}

<div class="panel error-pagina mx-auto text-center py-5">
    <img src="~/img/logo-navbar.png" alt="Municipalidad de Unquillo" style="height: 72px;" class="mb-4" />

    <i class="bi @icono error-icono"></i>
    <h1 class="display-3 fw-bold mb-1" style="color: var(--color-acento);">@codigo</h1>
    <h2 class="h4 fw-semibold mb-3">@titulo</h2>
    <p class="mb-4" style="color: var(--color-texto-suave);">@mensaje</p>

    <div class="d-flex justify-content-center gap-2 flex-wrap">
        <button type="button" class="btn btn-outline-secondary" onclick="history.back()">
            <i class="bi bi-arrow-left me-1"></i> Volver atrás
        </button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house-door me-1"></i> Volver al inicio
        </a>
    </div>
</div>

<style>
    .error-pagina {
        max-width: 560px;
        margin-top: 2rem;
    }

    .error-icono {
        display: block;
        font-size: 2.5rem;
        color: var(--color-texto-suave);
        margin-bottom: 0.5rem;
    }
</style>