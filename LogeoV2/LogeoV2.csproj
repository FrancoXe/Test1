    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>8a4fa963-fe3d-415a-bf52-f5e2b261ab17</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
